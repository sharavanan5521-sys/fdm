# ════════════════════════════════════════════════════════════
#  Freedom Discovery — server security rules (Hostinger reads this
#  file from the site root). Deliberately NOT included here:
#   - an HTTP→HTTPS redirect: Hostinger's CDN already does it, and a
#     second one at the origin can cause a redirect loop;
#   - long cache lifetimes: posters are replaced under the SAME filename,
#     so long caching would show visitors stale posters.
#  If you add a new third-party service (analytics, chat widget, embed),
#  add its domain to the Content-Security-Policy below or it will be blocked.
# ════════════════════════════════════════════════════════════

# No folder listings
Options -Indexes

# UTF-8 for plain-text files (llms.txt, robots.txt, sitemap.xml)
AddCharset UTF-8 .txt .xml

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host: www.freedomdiscovery.net → freedomdiscovery.net (301, path kept)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Hidden files & folders (.git, .claude, .vscode, .env …) — except /.well-known (SSL renewal)
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
</IfModule>

# Repo / tooling files that should never be public (README.md, backups, archives …)
<FilesMatch "(^\.|\.(md|log|bak|old|orig|swp|sql|sh|ini|zip|tar|gz)$|~$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Always use HTTPS for a year once a browser has visited (no includeSubDomains,
  # so a subdomain without SSL can never be locked out)
  Header always set Strict-Transport-Security "max-age=31536000"

  # Only load code and assets from places the site actually uses:
  #   self · Google Fonts · cdnjs (Font Awesome) · Google Maps & YouTube embeds.
  # 'unsafe-inline' is allowed for STYLES only (small style="" attributes, e.g.
  # review avatar colours); scripts must come from /js — no inline scripts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; media-src 'self'; frame-src https://maps.google.com https://www.google.com https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Don't guess file types (stops files being run as scripts)
  Header always set X-Content-Type-Options "nosniff"

  # Nobody may frame the site inside their own page (clickjacking) — older browsers
  Header always set X-Frame-Options "SAMEORIGIN"

  # Send only the domain (not full page URLs) to other sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The site never needs these browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()"

  # Popups we open (WhatsApp) can't reach back into this page
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>
